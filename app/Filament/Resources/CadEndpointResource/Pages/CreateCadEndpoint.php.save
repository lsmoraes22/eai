<?php

namespace App\Filament\Resources\CadEndpointResource\Pages;

use App\Filament\Resources\CadEndpointResource;
use Filament\Actions;
use Filament\Resources\Pages\CreateRecord;

class CreateCadEndpoint extends CreateRecord
{
    protected static string $resource = CadEndpointResource::class;

    protected function mutateFormDataBeforeCreate(array $data): array
    {
        // Verifica se 'timer' está presente e não é nulo/zero
        if (isset($data['timer']) && (int) $data['timer'] > 0) {
            // Calcula o próximo horário de execução
            // now() + timer minutos, e arredonda para o minuto inicial (segundos = 0)
            $data['next_run'] = Carbon::now()
                ->addMinutes((int) $data['timer'])
                ->startOfMinute();
        } else {
            // Garante que next_run seja nulo se não houver timer
            $data['next_run'] = null;
        }

        return $data;
    }
}
