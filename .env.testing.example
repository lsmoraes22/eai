APP_NAME=EAI
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Dedicated disposable database; phpunit.xml fixes this database name.
# Create a test-only user with privileges restricted to eai_testing.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eai_testing
DB_USERNAME=eai_testing
DB_PASSWORD=
# Optional: set DB_SOCKET only in your local .env.testing when using a Unix socket.

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
